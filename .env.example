# @BotFather bergan token (faqat shu yerda, kodga yozilmaydi)
BOT_TOKEN=123456:ABC-DEF...

# Asosiy admin Telegram ID si
ADMIN_ID=5751975734

# Kinolar saqlanadigan yopiq kanal ID si (bot u yerda admin)
STORAGE_CHANNEL_ID=-1004446986274

# Zaxira kanal ID si (ixtiyoriy): yangi videolar shu kanalga ham nusxalanadi
BACKUP_CHANNEL_ID=

# Ochiq kanal (ixtiyoriy): yangi kino postlari uchun ID yoki @username va havola
PUBLIC_CHANNEL_ID=
