# TMDB API kaliti (v3 api_key yoki v4 Read Access Token)
TMDB_API_KEY=

# @BotFather -> Payments -> Click provider tokeni (bo'sh bo'lsa Click tugmasi chiqmaydi)
CLICK_PROVIDER_TOKEN=

# SQLite baza fayli (Railway Volume /data ga ulanadi)
DB_PATH=/data/kinobot.db

# To'lov va yordam uchun admin username (ixtiyoriy, @ siz)
